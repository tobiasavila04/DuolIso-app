# Copiá este archivo a ".env" y ajustá los valores para tu entorno.
# ".env" NO se sube a git (ver .gitignore) — cada entorno (tu compu, Render, etc.) tiene el suyo.

ENTORNO=desarrollo

# Dominios que pueden llamar a esta API, separados por coma. En producción,
# poné acá SOLO la URL real de tu frontend deployado (ej. tu-app.vercel.app),
# nunca "*" — con "*" cualquier sitio podría leer datos de tu API desde el
# navegador de un usuario logueado.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

RATE_LIMIT=60/minute
